      <column caption='Calc_IncrMujeresSeleccion' datatype='real' datatype-customized='true' name='[Calc_TasaHombres (copy)_3648907947053072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;tasa&quot; THEN&#10;    (SUM([incrementos_mujeres]) / SUM([Poblacion Mujeres])) * 100000&#10;ELSE&#10;    SUM([incrementos_mujeres])&#10;END' />
      </column>
      <column caption='Calc_YhatLower' datatype='real' name='[Calc_YhatUpper (copy)_1086773809197064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([yhat]) - WINDOW_STDEV(SUM([yhat]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_Filter_UltimasSemanas' datatype='boolean' name='[Calculation_0436616130711552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[ds] &gt;= DATEADD(&#10;  &apos;week&apos;,&#10;  -104,&#10;  { FIXED : MAX([ds]) }&#10;)' />
      </column>
      <column caption='Metrics_RMSE' datatype='real' name='[Calculation_1086773793894400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [modelo_productivo]&#10;WHEN &quot;prophet&quot; THEN [rmse_prophet]&#10;WHEN &quot;deepar&quot; THEN [rmse_deepar]&#10;WHEN &quot;ensemble&quot; THEN [rmse_ensemble]&#10;WHEN &quot;stacking&quot; THEN [rmse_stacking]&#10;ELSE NULL&#10;END' />
      </column>
