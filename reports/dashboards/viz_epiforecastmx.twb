            <column-instance column='[Calculation_4518071957065730]' derivation='None' name='[none:Calculation_4518071957065730:nk]' pivot='key' type='nominal' />
            <column-instance column='[ds]' derivation='None' name='[none:ds:qk]' pivot='key' type='quantitative' />
            <column-instance column='[entidad]' derivation='None' name='[none:entidad:nk]' pivot='key' type='nominal' />
            <column-instance column='[padecimiento]' derivation='None' name='[none:padecimiento:nk]' pivot='key' type='nominal' />
