      <repository-location derived-from='https://public.tableau.com/workbooks/viz_epiforecastmx/Mxicoencategoras?rev=' id='127181858' path='/workbooks/viz_epiforecastmx' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='tableau' name='federated.13xqsv00m8lbbq1am9y6v0etlxi0' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Param_ColorMapaDiscreto' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Densidad Poblacional&quot;'>
              <calculation class='tableau' formula='&quot;Densidad Poblacional&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13xqsv00m8lbbq1am9y6v0etlxi0'>
            <column caption='Calc_ValorSelecMapaDiscreto' datatype='string' name='[Calculation_3648907925143565]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Región&quot; THEN [Region]&#10;WHEN &quot;Región Socio-Urbana&quot; THEN [Region Socio-Urbana]&#10;WHEN &quot;Ratio H/M&quot; THEN [ratio_h_m_cat]&#10;WHEN &quot;Tamaño Poblacional (Bins)&quot; THEN [tamano_poblacional_predefinido]&#10;WHEN &quot;Tamaño Poblacional (Percentil)&quot; THEN [tamano_poblacional_grupo_percentil]&#10;WHEN &quot;Extensión Territorial&quot; THEN [extension_territorial_percentil]&#10;WHEN &quot;Densidad Poblacional&quot; THEN [densidad_poblacional_percentil]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Region Socio-Urbana1' datatype='string' name='[Region Socio-Urbana]' role='dimension' type='nominal' />
            <column caption='Region1' datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column caption='Densidad Poblacional Percentil' datatype='string' name='[densidad_poblacional_percentil]' role='dimension' type='nominal' />
            <column caption='Ds' datatype='date' name='[ds]' role='dimension' type='ordinal' />
