    <worksheet name='Metrics'>
      <repository-location derived-from='https://public.tableau.com/workbooks/viz_epiforecastmx/Metrics?rev=' id='127269661' path='/workbooks/viz_epiforecastmx' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='tableau' name='federated.13xqsv00m8lbbq1am9y6v0etlxi0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='General' caption='Param_GeneroSelecc' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
              <aliases>
                <alias key='&quot;Total&quot;' value='General' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13xqsv00m8lbbq1am9y6v0etlxi0'>
            <column caption='Metrics_SMAPE' datatype='real' name='[Calculation_1086773794385923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [modelo_productivo]&#10;WHEN &quot;prophet&quot; THEN [smape_prophet]&#10;WHEN &quot;deepar&quot; THEN [smape_deepar]&#10;WHEN &quot;ensemble&quot; THEN [smape_ensemble]&#10;WHEN &quot;stacking&quot; THEN [smape_stacking]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Calc_ConfianzaNivel' datatype='string' name='[Calculation_1120718644871168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_1086773794385923]) THEN&#10;    &quot;Insuficiente&quot;&#10;ELSEIF [Calculation_1086773794385923] &lt; 15.0 THEN&#10;    &quot;Excelente&quot;&#10;ELSEIF [Calculation_1086773794385923] &lt;= 25.0 THEN&#10;    &quot;Bueno&quot;&#10;ELSE&#10;    &quot;Necesita mejora&quot;&#10;END' />
            </column>
            <column caption='Calc_Filtro_Genero' datatype='boolean' name='[Calculation_4518071957065730]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[meta_modo] =&#10;CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Total&quot; THEN &quot;general&quot;&#10;    WHEN &quot;Hombres&quot; THEN &quot;hombres&quot;&#10;    WHEN &quot;Mujeres&quot; THEN &quot;mujeres&quot;&#10;END' />
