            <column-instance column='[padecimiento]' derivation='None' name='[none:padecimiento:nk]' pivot='key' type='nominal' />
            <column caption='Padecimiento' datatype='string' name='[padecimiento]' role='dimension' type='nominal' />
            <column datatype='real' name='[smape]' role='measure' type='quantitative' />
            <column-instance column='[ds]' derivation='Year' name='[yr:ds:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.13xqsv00m8lbbq1am9y6v0etlxi0].[none:Calculation_1716244240232448:nk]'>
            <groupfilter function='member' level='[none:Calculation_1716244240232448:nk]' member='&quot;Region&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
