          <datasource-dependencies datasource='Parameters'>
            <column caption='Param_ColorMapaContinuo' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Superficie (km2)&quot;'>
              <calculation class='tableau' formula='&quot;Superficie (km2)&quot;' />
              <aliases>
                <alias key='&quot;Incremento de Casos (Hombres)&quot;' value='Casos (Hombres)' />
                <alias key='&quot;Incremento de Casos (Mujeres)&quot;' value='Casos (Mujeres)' />
                <alias key='&quot;Incremento de Casos (Total)&quot;' value='Casos (Total)' />
              </aliases>
