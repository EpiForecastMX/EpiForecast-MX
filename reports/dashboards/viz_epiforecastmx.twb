    <worksheet name='Nacional52Semanas'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Últimas 52 semanas</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau' name='federated.13xqsv00m8lbbq1am9y6v0etlxi0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='General' caption='Param_GeneroSelecc' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
              <aliases>
                <alias key='&quot;Total&quot;' value='General' />
              </aliases>
            </column>
            <column caption='Param_FechaInicioPrediccion' datatype='datetime' name='[Parameter 5]' param-domain-type='list' role='measure' type='quantitative' value='#2026-02-22 00:27:21#'>
              <calculation class='tableau' formula='#2026-02-22 00:27:21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13xqsv00m8lbbq1am9y6v0etlxi0'>
            <column caption='Calc_Filter_UltimasSemanas' datatype='boolean' name='[Calculation_0436616130711552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[ds] &gt;= DATEADD(&#10;  &apos;week&apos;,&#10;  -104,&#10;  { FIXED : MAX([ds]) }&#10;)' />
            </column>
            <column caption='Metrics_RMSE' datatype='real' name='[Calculation_1086773793894400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [modelo_productivo]&#10;WHEN &quot;prophet&quot; THEN [rmse_prophet]&#10;WHEN &quot;deepar&quot; THEN [rmse_deepar]&#10;WHEN &quot;ensemble&quot; THEN [rmse_ensemble]&#10;WHEN &quot;stacking&quot; THEN [rmse_stacking]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Metrics_MAE' datatype='real' name='[Calculation_1086773794000897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [modelo_productivo]&#10;WHEN &quot;prophet&quot; THEN [mae_prophet]&#10;WHEN &quot;deepar&quot; THEN [mae_deepar]&#10;WHEN &quot;ensemble&quot; THEN [mae_ensemble]&#10;WHEN &quot;stacking&quot; THEN [mae_stacking]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Metrics_MAPE' datatype='real' name='[Calculation_1086773794242562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [modelo_productivo]&#10;WHEN &quot;prophet&quot; THEN [mape_prophet]&#10;WHEN &quot;deepar&quot; THEN [mape_deepar]&#10;WHEN &quot;ensemble&quot; THEN [mape_ensemble]&#10;WHEN &quot;stacking&quot; THEN [mape_stacking]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Metrics_MASE' datatype='real' name='[Calculation_1086773794557956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [modelo_productivo]&#10;WHEN &quot;prophet&quot; THEN [mase_prophet]&#10;WHEN &quot;deepar&quot; THEN [mase_deepar]&#10;WHEN &quot;ensemble&quot; THEN [mase_ensemble]&#10;WHEN &quot;stacking&quot; THEN [mase_stacking]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Calc_FilterEntidadOnly' datatype='string' name='[Calculation_1716244240232448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [entidad] = &quot;Nacional&quot; THEN &quot;Nacional&quot;&#10;&#10;ELSEIF &#10;    [entidad] = &quot;Region Metropolitana alta&quot;&#10;    OR [entidad] = &quot;Region Rural / dispersa&quot;&#10;    OR [entidad] = &quot;Region Sur-Sureste vulnerable&quot;&#10;    OR [entidad] = &quot;Region Urbana media&quot;&#10;THEN &quot;Region&quot;&#10;&#10;ELSE &quot;Estado&quot;&#10;END' />
            </column>
            <column caption='Calc_Y_Selected' datatype='integer' name='[Calculation_4518071955279873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Total&quot; THEN [incrementos_total]&#10;WHEN &quot;Hombres&quot; THEN [incrementos_hombres]&#10;WHEN &quot;Mujeres&quot; THEN [incrementos_mujeres]&#10;END' />
            </column>
            <column caption='Calc_Filtro_Genero' datatype='boolean' name='[Calculation_4518071957065730]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[meta_modo] =&#10;CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Total&quot; THEN &quot;general&quot;&#10;    WHEN &quot;Hombres&quot; THEN &quot;hombres&quot;&#10;    WHEN &quot;Mujeres&quot; THEN &quot;mujeres&quot;&#10;END' />
