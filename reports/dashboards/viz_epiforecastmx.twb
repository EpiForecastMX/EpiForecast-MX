      <column caption='Calc_IncrMujeresSeleccion' datatype='real' datatype-customized='true' name='[Calc_TasaHombres (copy)_3648907947053072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;tasa&quot; THEN&#10;    (SUM([incrementos_mujeres]) / SUM([Poblacion Mujeres])) * 100000&#10;ELSE&#10;    SUM([incrementos_mujeres])&#10;END' />
      </column>
      <column caption='Calc_YhatLower' datatype='real' name='[Calc_YhatUpper (copy)_1086773809197064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([yhat]) - WINDOW_STDEV(SUM([yhat]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_Filter_UltimasSemanas' datatype='boolean' name='[Calculation_0436616130711552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[ds] &gt;= DATEADD(&#10;  &apos;week&apos;,&#10;  -104,&#10;  { FIXED : MAX([ds]) }&#10;)' />
      </column>
      <column caption='Metrics_RMSE' datatype='real' name='[Calculation_1086773793894400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [modelo_productivo]&#10;WHEN &quot;prophet&quot; THEN [rmse_prophet]&#10;WHEN &quot;deepar&quot; THEN [rmse_deepar]&#10;WHEN &quot;ensemble&quot; THEN [rmse_ensemble]&#10;WHEN &quot;stacking&quot; THEN [rmse_stacking]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Metrics_MAE' datatype='real' name='[Calculation_1086773794000897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [modelo_productivo]&#10;WHEN &quot;prophet&quot; THEN [mae_prophet]&#10;WHEN &quot;deepar&quot; THEN [mae_deepar]&#10;WHEN &quot;ensemble&quot; THEN [mae_ensemble]&#10;WHEN &quot;stacking&quot; THEN [mae_stacking]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Metrics_MAPE' datatype='real' name='[Calculation_1086773794242562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [modelo_productivo]&#10;WHEN &quot;prophet&quot; THEN [mape_prophet]&#10;WHEN &quot;deepar&quot; THEN [mape_deepar]&#10;WHEN &quot;ensemble&quot; THEN [mape_ensemble]&#10;WHEN &quot;stacking&quot; THEN [mape_stacking]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Metrics_SMAPE' datatype='real' name='[Calculation_1086773794385923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [modelo_productivo]&#10;WHEN &quot;prophet&quot; THEN [smape_prophet]&#10;WHEN &quot;deepar&quot; THEN [smape_deepar]&#10;WHEN &quot;ensemble&quot; THEN [smape_ensemble]&#10;WHEN &quot;stacking&quot; THEN [smape_stacking]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Metrics_MASE' datatype='real' name='[Calculation_1086773794557956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [modelo_productivo]&#10;WHEN &quot;prophet&quot; THEN [mase_prophet]&#10;WHEN &quot;deepar&quot; THEN [mase_deepar]&#10;WHEN &quot;ensemble&quot; THEN [mase_ensemble]&#10;WHEN &quot;stacking&quot; THEN [mase_stacking]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Calc_YhatUpper' datatype='real' name='[Calculation_1086773808459783]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([yhat]) + WINDOW_STDEV(SUM([yhat]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_ConfianzaNivel' datatype='string' name='[Calculation_1120718644871168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_1086773794385923]) THEN&#10;    &quot;Insuficiente&quot;&#10;ELSEIF [Calculation_1086773794385923] &lt; 15.0 THEN&#10;    &quot;Excelente&quot;&#10;ELSEIF [Calculation_1086773794385923] &lt;= 25.0 THEN&#10;    &quot;Bueno&quot;&#10;ELSE&#10;    &quot;Necesita mejora&quot;&#10;END' />
      </column>
      <column caption='Calc_ConfianzaPorcentaje' datatype='real' name='[Calculation_1120718644989953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_1086773794557956]) THEN NULL&#10;ELSEIF [Calculation_1086773794557956] &lt;= 0.7 THEN 100&#10;ELSEIF [Calculation_1086773794557956] &gt;= 1.0 THEN 0&#10;ELSE (1.0 - [Calculation_1086773794557956]) / (1.0 - 0.7) * 100&#10;END' />
      </column>
      <column caption='Calc_FechaInicioPredicc' datatype='date' name='[Calculation_1474349192613888]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX( IF NOT ISNULL([Calculation_4518071955279873]) THEN [ds] END ) }' />
      </column>
      <column caption='Calc_FilterEntidadOnly' datatype='string' name='[Calculation_1716244240232448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [entidad] = &quot;Nacional&quot; THEN &quot;Nacional&quot;&#10;&#10;ELSEIF &#10;    [entidad] = &quot;Region Metropolitana alta&quot;&#10;    OR [entidad] = &quot;Region Rural / dispersa&quot;&#10;    OR [entidad] = &quot;Region Sur-Sureste vulnerable&quot;&#10;    OR [entidad] = &quot;Region Urbana media&quot;&#10;THEN &quot;Region&quot;&#10;&#10;ELSE &quot;Estado&quot;&#10;END' />
      </column>
      <column caption='Calc_Filter_RegionSU' datatype='boolean' name='[Calculation_2796789560590337]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[entidad] = [Parameters].[Param_GeneroSelecc (copy)_2796789559005184]' />
      </column>
      <column caption='Calc_Norm_DensidadPoblacional' datatype='real' name='[Calculation_3648907901136898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([densidad_poblacion]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_Norm_IncrementosHombres' datatype='real' datatype-customized='true' name='[Calculation_3648907901296643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([incrementos_hombres]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_Norm_IncrementosMujeres' datatype='real' datatype-customized='true' name='[Calculation_3648907901407236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([incrementos_mujeres]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_Norm_IncrementosTotal' datatype='real' name='[Calculation_3648907901468677]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([incrementos_total]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_Norm_ValorRealSeleccionado' datatype='real' name='[Calculation_3648907901730823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Densidad Poblacional (hab/km2)&quot; &#10;THEN [densidad_poblacion] &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Hombres)&quot; &#10;THEN [incrementos_hombres] &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Mujeres)&quot; &#10;THEN [incrementos_mujeres] &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Total)&quot; &#10;THEN [incrementos_total] &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Superficie (km2)&quot; &#10;THEN [Superficie_km2] END' />
      </column>
      <column caption='Calc_Norm_ColorContinuo' datatype='real' name='[Calculation_3648907902615560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Densidad Poblacional (hab/km2)&quot; THEN&#10;    [Calculation_3648907901136898]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Hombres)&quot; THEN&#10;    [Calculation_3648907901296643]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Mujeres)&quot; THEN&#10;    [Calculation_3648907901407236]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Total)&quot; THEN&#10;    [Calculation_3648907901468677]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Superficie (km2)&quot; THEN&#10;    [Calculation_3648907902984202]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_Norm_Superficie' datatype='real' name='[Calculation_3648907902984202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([Superficie_km2]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_ValorSelecMapaDiscreto' datatype='string' name='[Calculation_3648907925143565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Región&quot; THEN [Region]&#10;WHEN &quot;Región Socio-Urbana&quot; THEN [Region Socio-Urbana]&#10;WHEN &quot;Ratio H/M&quot; THEN [ratio_h_m_cat]&#10;WHEN &quot;Tamaño Poblacional (Bins)&quot; THEN [tamano_poblacional_predefinido]&#10;WHEN &quot;Tamaño Poblacional (Percentil)&quot; THEN [tamano_poblacional_grupo_percentil]&#10;WHEN &quot;Extensión Territorial&quot; THEN [extension_territorial_percentil]&#10;WHEN &quot;Densidad Poblacional&quot; THEN [densidad_poblacional_percentil]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Calc_IncrHombres_Seleccion' datatype='real' datatype-customized='true' name='[Calculation_3648907946139663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;tasa&quot; THEN&#10;    (SUM([incrementos_hombres]) / SUM([Poblacion Hombres])) * 100000&#10;ELSE&#10;    SUM([incrementos_hombres])&#10;END' />
      </column>
      <column caption='Calc_YhatBandWidth' datatype='real' name='[Calculation_3648907956518929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1086773808459783]-[Calc_YhatUpper (copy)_1086773809197064]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Nivel Geográfico' datatype='string' name='[Calculation_4056692820492288]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [entidad] = &quot;Nacional&quot; THEN &quot;Nacional&quot;&#10;ELSEIF CONTAINS([entidad], &quot;Region&quot;) THEN &quot;Regional&quot;&#10;ELSE &quot;Estatal&quot;&#10;END' />
      </column>
      <column caption='Calc_Series' datatype='integer' name='[Calculation_4056692822335496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([padecimiento] + [entidad] + [meta_modo])' />
      </column>
      <column caption='Calc_NivelPorcentaje' datatype='real' name='[Calculation_4056692823908361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([padecimiento] + [entidad] + [meta_modo])&#10;/&#10;WINDOW_SUM(COUNTD([padecimiento] + [entidad] + [meta_modo]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI_NivelConfianza' datatype='integer' name='[Calculation_4104381753483272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;  IF [Calculation_1086773794385923] &lt; 150&#10;  THEN [archivo_modelo_usado]&#10;  END&#10;)' />
      </column>
      <column caption='KPI_ConfianzaInsuficiente' datatype='integer' name='[Calculation_4104381763026954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;  IF [confianza_original] = &quot;insuficiente&quot;&#10;  THEN [archivo_modelo_usado]&#10;  END&#10;)' />
      </column>
      <column caption='KPI_FallbackRegional' datatype='integer' name='[Calculation_4104381763813388]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;  IF [archivo_modelo_usado] &lt;&gt; [archivo_modelo_original]&#10;  THEN [archivo_modelo_usado]&#10;  END&#10;)' />
      </column>
      <column caption='Calc_Yhat_Selected' datatype='real' name='[Calculation_4518071954993152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [meta_modo] =&#10;    CASE [Parameters].[Parameter 4]&#10;        WHEN &quot;Total&quot; THEN &quot;general&quot;&#10;        WHEN &quot;Hombres&quot; THEN &quot;hombres&quot;&#10;        WHEN &quot;Mujeres&quot; THEN &quot;mujeres&quot;&#10;    END&#10;THEN [yhat]&#10;END' />
      </column>
      <column caption='Calc_Y_Selected' datatype='integer' name='[Calculation_4518071955279873]' role='measure' type='quantitative'>
