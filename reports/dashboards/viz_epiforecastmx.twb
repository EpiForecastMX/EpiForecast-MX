      <repository-location derived-from='https://public.tableau.com/workbooks/viz_epiforecastmx/MapadeMxico?rev=' id='127181857' path='/workbooks/viz_epiforecastmx' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='tableau' name='federated.13xqsv00m8lbbq1am9y6v0etlxi0' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Casos (Hombres)' caption='Param_ColorMapaContinuo' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Incremento de Casos (Hombres)&quot;'>
              <calculation class='tableau' formula='&quot;Incremento de Casos (Hombres)&quot;' />
              <aliases>
                <alias key='&quot;Incremento de Casos (Hombres)&quot;' value='Casos (Hombres)' />
                <alias key='&quot;Incremento de Casos (Mujeres)&quot;' value='Casos (Mujeres)' />
                <alias key='&quot;Incremento de Casos (Total)&quot;' value='Casos (Total)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13xqsv00m8lbbq1am9y6v0etlxi0'>
            <column caption='Calc_Norm_DensidadPoblacional' datatype='real' name='[Calculation_3648907901136898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([densidad_poblacion]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Calc_Norm_IncrementosHombres' datatype='real' datatype-customized='true' name='[Calculation_3648907901296643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([incrementos_hombres]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Calc_Norm_IncrementosMujeres' datatype='real' datatype-customized='true' name='[Calculation_3648907901407236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([incrementos_mujeres]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Calc_Norm_IncrementosTotal' datatype='real' name='[Calculation_3648907901468677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([incrementos_total]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Calc_Norm_ValorRealSeleccionado' datatype='real' name='[Calculation_3648907901730823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Densidad Poblacional (hab/km2)&quot; &#10;THEN [densidad_poblacion] &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Hombres)&quot; &#10;THEN [incrementos_hombres] &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Mujeres)&quot; &#10;THEN [incrementos_mujeres] &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Total)&quot; &#10;THEN [incrementos_total] &#10;ELSEIF [Parameters].[Parameter 1] = &quot;Superficie (km2)&quot; &#10;THEN [Superficie_km2] END' />
            </column>
            <column caption='Calc_Norm_ColorContinuo' datatype='real' name='[Calculation_3648907902615560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Densidad Poblacional (hab/km2)&quot; THEN&#10;    [Calculation_3648907901136898]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Hombres)&quot; THEN&#10;    [Calculation_3648907901296643]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Mujeres)&quot; THEN&#10;    [Calculation_3648907901407236]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Total)&quot; THEN&#10;    [Calculation_3648907901468677]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Superficie (km2)&quot; THEN&#10;    [Calculation_3648907902984202]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Calc_Norm_Superficie' datatype='real' name='[Calculation_3648907902984202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([Superficie_km2]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Superficie km2' datatype='real' name='[Superficie_km2]' role='measure' type='quantitative' />
            <column caption='Densidad Poblacion' datatype='real' name='[densidad_poblacion]' role='measure' type='quantitative' />
            <column caption='Ds' datatype='date' name='[ds]' role='dimension' type='ordinal' />
            <column caption='Entidad' datatype='string' name='[entidad]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
