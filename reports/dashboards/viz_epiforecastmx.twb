      <repository-location derived-from='https://public.tableau.com/workbooks/viz_epiforecastmx/Casosporao?rev=' id='127181860' path='/workbooks/viz_epiforecastmx' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='scaffold+ (tableau)' name='federated.1gitw2r0jt17eb170paxc0v2qn2d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Conteo de Incrementos' caption='Param_Norm_100kHab' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;incrementos&quot;'>
              <calculation class='tableau' formula='&quot;incrementos&quot;' />
              <aliases>
                <alias key='&quot;incrementos&quot;' value='Conteo de Incrementos' />
                <alias key='&quot;tasa&quot;' value='Tasa de Incrementos (/100k)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gitw2r0jt17eb170paxc0v2qn2d'>
            <column caption='Calc_IncrMujeresSeleccion' datatype='real' datatype-customized='true' name='[Calc_TasaHombres (copy)_3648907947053072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;tasa&quot; THEN&#10;    (SUM([incrementos_mujeres]) / SUM([Poblacion Mujeres])) * 100000&#10;ELSE&#10;    SUM([incrementos_mujeres])&#10;END' />
