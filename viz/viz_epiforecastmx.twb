        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Densidad Poblacional (hab/km2)&quot; THEN&#10;    [densidad_poblacion]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Hombres)&quot; THEN&#10;    [incrementos_hombres]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Mujeres)&quot; THEN&#10;    [incrementos_mujeres]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Total)&quot; THEN&#10;    [incrementos_total]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Superficie (km2)&quot; THEN&#10;    [Superficie_km2]&#10;END' />
