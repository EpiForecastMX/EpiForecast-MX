      <column caption='Calc_ConfianzaNivel' datatype='string' name='[Calculation_1120718644871168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_1120718644989953]) THEN&#10;    &quot;Insuficiente&quot;&#10;ELSEIF [Calculation_1120718644989953] &gt;= 75 THEN&#10;    &quot;Alta&quot;&#10;ELSEIF [Calculation_1120718644989953] &gt;= 50 THEN&#10;    &quot;Media&quot;&#10;ELSE&#10;    &quot;Baja&quot;&#10;END' />
      </column>
      <column caption='Calc_ConfianzaPorcentaje' datatype='real' name='[Calculation_1120718644989953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1-[mase_usado])*100' />
