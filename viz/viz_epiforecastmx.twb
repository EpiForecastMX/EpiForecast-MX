      <column caption='Calc_IncrMujeresSeleccion' datatype='real' datatype-customized='true' name='[Calc_TasaHombres (copy)_3648907947053072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;tasa&quot; THEN&#10;    (SUM([incrementos_mujeres]) / SUM([Poblacion Mujeres])) * 100000&#10;ELSE&#10;    SUM([incrementos_mujeres])&#10;END' />
      </column>
      <column caption='Calc_Filter_UltimasSemanas' datatype='boolean' name='[Calculation_0436616130711552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[ds] &gt;= DATEADD(&#10;  &apos;week&apos;,&#10;  -134,&#10;  { FIXED : MAX([ds]) }&#10;)' />
      </column>
      <column caption='Calc_Norm_DensidadPoblacional' datatype='real' name='[Calculation_3648907901136898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([densidad_poblacion]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_Norm_IncrementosHombres' datatype='real' datatype-customized='true' name='[Calculation_3648907901296643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([incrementos_hombres]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_Norm_IncrementosMujeres' datatype='real' datatype-customized='true' name='[Calculation_3648907901407236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([incrementos_mujeres]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_Norm_IncrementosTotal' datatype='real' name='[Calculation_3648907901468677]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([incrementos_total]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_Norm_ValorRealSeleccionado' datatype='real' name='[Calculation_3648907901730823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Densidad Poblacional (hab/km2)&quot; THEN&#10;    [densidad_poblacion]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Hombres)&quot; THEN&#10;    [incrementos_hombres]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Mujeres)&quot; THEN&#10;    [incrementos_mujeres]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Total)&quot; THEN&#10;    [incrementos_total]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Superficie (km2)&quot; THEN&#10;    [Superficie_km2]&#10;END' />
      </column>
      <column caption='Calc_Norm_ColorContinuo' datatype='real' name='[Calculation_3648907902615560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Densidad Poblacional (hab/km2)&quot; THEN&#10;    [Calculation_3648907901136898]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Hombres)&quot; THEN&#10;    [Calculation_3648907901296643]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Mujeres)&quot; THEN&#10;    [Calculation_3648907901407236]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Incremento de Casos (Total)&quot; THEN&#10;    [Calculation_3648907901468677]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Superficie (km2)&quot; THEN&#10;    [Calculation_3648907902984202]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_Norm_Superficie' datatype='real' name='[Calculation_3648907902984202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100.0 * RANK_PERCENTILE(SUM([Superficie_km2]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calc_ValorSelecMapaDiscreto' datatype='string' name='[Calculation_3648907925143565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Región&quot; THEN [Region]&#10;WHEN &quot;Región Socio-Urbana&quot; THEN [Region Socio-Urbana]&#10;WHEN &quot;Ratio H/M&quot; THEN [ratio_h_m_cat]&#10;WHEN &quot;Tamaño Poblacional (Bins)&quot; THEN [tamano_poblacional_predefinido]&#10;WHEN &quot;Tamaño Poblacional (Percentil)&quot; THEN [tamano_poblacional_grupo_percentil]&#10;WHEN &quot;Extensión Territorial&quot; THEN [extension_territorial_percentil]&#10;WHEN &quot;Densidad Poblacional&quot; THEN [densidad_poblacional_percentil]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Calc_IncrHombres_Seleccion' datatype='real' datatype-customized='true' name='[Calculation_3648907946139663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;tasa&quot; THEN&#10;    (SUM([incrementos_hombres]) / SUM([Poblacion Hombres])) * 100000&#10;ELSE&#10;    SUM([incrementos_hombres])&#10;END' />
      </column>
      <column caption='Calc_YhatBandWidth' datatype='real' name='[Calculation_3648907956518929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[yhat_upper]-[yhat_lower]' />
      </column>
      <column caption='Calc_Yhat_Selected' datatype='real' name='[Calculation_4518071954993152]' role='measure' type='quantitative'>
