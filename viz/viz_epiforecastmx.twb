      </column>
      <column caption='Calc_Y_Selected' datatype='real' name='[Calculation_4518071955279873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Total&quot; THEN [incrementos_total]&#10;WHEN &quot;Hombres&quot; THEN [incrementos_hombres]&#10;WHEN &quot;Mujeres&quot; THEN [incrementos_mujeres]&#10;END' />
