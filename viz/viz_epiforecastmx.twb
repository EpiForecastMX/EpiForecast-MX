      <column caption='Calc_IncrMujeresSeleccion' datatype='real' datatype-customized='true' name='[Calc_TasaHombres (copy)_3648907947053072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;tasa&quot; THEN&#10;    (SUM([incrementos_mujeres]) / SUM([Poblacion Mujeres])) * 100000&#10;ELSE&#10;    SUM([incrementos_mujeres])&#10;END' />
      </column>
      <column caption='Calc_Filter_UltimasSemanas' datatype='boolean' name='[Calculation_0436616130711552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[ds] &gt;= DATEADD(&#10;  &apos;week&apos;,&#10;  -104,&#10;  { FIXED : MAX([ds]) }&#10;)' />
      </column>
      <column caption='Calc_ConfianzaNivel' datatype='string' name='[Calculation_1120718644871168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([mase_usado]) THEN&#10;    &quot;Insuficiente&quot;&#10;ELSEIF [mase_usado] &lt; 0.7 THEN&#10;    &quot;Excelente&quot;&#10;ELSEIF [mase_usado] &lt;= 1.0 THEN&#10;    &quot;Bueno&quot;&#10;ELSE&#10;    &quot;Necesita mejora&quot;&#10;END' />
      </column>
      <column caption='Calc_ConfianzaPorcentaje' datatype='real' name='[Calculation_1120718644989953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([mase_usado]) THEN NULL&#10;ELSEIF [mase_usado] &lt;= 0.7 THEN 100&#10;ELSEIF [mase_usado] &gt;= 1.0 THEN 0&#10;ELSE (1.0 - [mase_usado]) / (1.0 - 0.7) * 100&#10;END' />
      </column>
      <column caption='Calc_FechaInicioPredicc' datatype='date' name='[Calculation_1474349192613888]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX( IF NOT ISNULL([Calculation_4518071955279873]) THEN [ds] END ) }' />
