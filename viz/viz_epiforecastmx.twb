              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;tasa&quot; THEN&#10;    (SUM([incrementos_mujeres]) / SUM([Poblacion Mujeres])) * 100000&#10;ELSE&#10;    SUM([incrementos_mujeres])&#10;END' />
