              <calculation class='tableau' formula='IF [meta_modo] =&#10;    CASE [Parameters].[Parameter 4]&#10;        WHEN &quot;Total&quot; THEN &quot;general&quot;&#10;        WHEN &quot;Hombres&quot; THEN &quot;hombres&quot;&#10;        WHEN &quot;Mujeres&quot; THEN &quot;mujeres&quot;&#10;    END&#10;THEN [yhat]&#10;END' />
