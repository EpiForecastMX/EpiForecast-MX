lightning_logs/
checkpoints/
*.ckpt

# Historial personal de la consola EPI (comandos/typos del usuario, no es codigo)
.epi_history.json

# Material en revision academica / doble-ciego (no va en entregables)
# Congresos/ se ignora en bloque (PDFs pesados, capturas, archivos de Canva) CON UNA
# EXCEPCION: el camera-ready de MICAI 2026 tiene que poder reconstruirse desde un clon
# limpio, asi que su master y sus dependencias si se versionan. Git no desciende a un
# directorio excluido, por eso hay que reincluir la cadena de directorios primero.
Congresos/*
!Congresos/MICAI/
Congresos/MICAI/*
!Congresos/MICAI/paper_camera_ready.tex
!Congresos/MICAI/paper_camera_ready.pdf
!Congresos/MICAI/llncs.cls
!Congresos/MICAI/splncs04.bst
!Congresos/MICAI/compila.sh
!Congresos/MICAI/Figures/
Congresos/MICAI/Figures/*
!Congresos/MICAI/Figures/*.pdf
!Congresos/MICAI/_archive/
Congresos/MICAI/_archive/*
!Congresos/MICAI/_archive/apendice_B_retirado.tex
!Congresos/MICAI/_archive/figura2_geo_heatmap_retirada.tex
!Congresos/MICAI/_archive/figura3_national_4models_retirada.tex
Stories/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

.venv/
!data/*.dvc
!data/.gitignore

# Permitir que Git vea data/processed/, pero ignorar su contenido
!/data/processed/
/data/processed/*
!data/processed/*.dvc
!data/processed/.gitignore
# Models (DVC-tracked en S3)
/models
!/data/raw/
/data/raw/*
!data/raw/*.dvc
!data/raw/.gitignore

