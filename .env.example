# .env.example
# EpiForecast-MX — plantilla de variables de entorno
#
# Copiar a .env y completar:
#   cp .env.example .env
# El código no carga .env automáticamente: expórtalo antes de correr
# (por ejemplo, `set -a; source .env; set +a`).
# Nunca versionar .env (está en .gitignore).

# ── AWS (remoto DVC, SageMaker, SNS) ───────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
SNS_TOPIC_ARN=                   # notificaciones del procesamiento de boletines

# ── Google ─────────────────────────────────────────────────────────
GEMINI_API_KEY=                  # consola EPI e índice RAG del EpiBot
GOOGLE_SERVICE_ACCOUNT_JSON=     # JSON de la service account (publish_gsheets)
GSHEETS_SPREADSHEET_ID=
GSHEETS_CHUNK_SIZE=

# ── Rutas y opciones locales ───────────────────────────────────────
EPIFORECAST_DASHBOARD=           # checkout del frontend (por defecto ../EpiForecast-IMSS-Dashboard)
EPIFORECAST_BUNDLE=              # bundle sellado del paper MICAI (scripts/paper_micai_2026)
SCRAPER_HEADLESS=1               # 0 abre el navegador visible al scrapear
PADECIMIENTO_TIPO=               # padecimiento del job de SageMaker (entrena_sagemaker.py)

# ── Aplicación ─────────────────────────────────────────────────────
APP_ENV=local                    # local | staging | production
